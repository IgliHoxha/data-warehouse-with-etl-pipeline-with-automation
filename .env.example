# Copy this file to .env and adjust as needed:  cp .env.example .env
#
# In all environments, the following files are loaded if they exist, the latter
# taking precedence over the former:
#
#  * .env                default values for the environment variables
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files. Never commit production
# secrets here — see https://symfony.com/doc/current/configuration/secrets.html

###> symfony/framework-bundle ###
APP_ENV=dev
# Generate a fresh one with:  php -r 'echo bin2hex(random_bytes(16));'
APP_SECRET=change-me
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Matches the MariaDB service in docker-compose.yml. Point host at 127.0.0.1
# instead of "mariadb" when running outside Docker.
DATABASE_URL="mysql://symfony:symfony@mariadb:3306/symfony?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# The scheduler transport. Doctrine keeps the queue in the database.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###
